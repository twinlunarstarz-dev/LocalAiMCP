# LocalAI reachable from inside the MCP container.
LOCALAI_BASE_URL=http://host.docker.internal:8080
# Optional LocalAI bearer token.
LOCALAI_API_KEY=

# Comma-separated Swagger operation names kept directly visible to MCP clients.
# Leave empty for the built-in ~20-tool system/generation/voice/3D preset.
# Use * to expose all Swagger operations, or none for gateway-only operation access.
LOCALAI_MCP_EXPOSED_TOOLS=

MCP_PORT=8000
MCP_WORKERS=2
LOCALAI_REQUEST_TIMEOUT=300
LOCALAI_CONNECT_TIMEOUT=10
LOCALAI_MCP_SAVE_BINARY=true
